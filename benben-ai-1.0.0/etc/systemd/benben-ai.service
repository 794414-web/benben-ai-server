[Unit]
Description=BenBen AI Assistant - Free LLM Proxy Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/usr/local/benben-ai
ExecStart=/usr/bin/python3 /usr/local/benben-ai/fake_llm_server.py
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=benben-ai

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/benben-ai /var/log/benben-ai /etc/benben-ai

[Install]
WantedBy=multi-user.target
